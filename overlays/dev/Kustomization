apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../base

namespace: dev
namePrefix: dev-

patches:
  - target:
      kind: Rollout
      name: manim-studio
    patch: |-
      - op: replace
        path: /spec/strategy/blueGreen/activeService
        value: dev-manim-studio-active
      - op: replace
        path: /spec/strategy/blueGreen/previewService
        value: dev-manim-studio-preview
