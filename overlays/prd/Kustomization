apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../base

namespace: prd
namePrefix: prd-

patches:
  - target:
      kind: Rollout
      name: manim-studio
    patch: |-
      - op: replace
        path: /spec/strategy/blueGreen/activeService
        value: prd-manim-studio-active
      - op: replace
        path: /spec/strategy/blueGreen/previewService
        value: prd-manim-studio-preview
      - op: replace
        path: /spec/template/spec/containers/0/env/0/value
        value: "Producción (PRD)"
      - op: replace
        path: /spec/template/spec/containers/0/env/1/value
        value: "-qh"
